# Dolenae web — example environment. Copy to `.env.local` and adjust.

# Public base URL (browser / client components). Must be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-only base URL (SSR / server components). Can be an internal address.
API_URL=http://localhost:3001/api

# Google OAuth — untuk login Google di web. Salin nilai dari Google Cloud Console.
# NEXT_PUBLIC_* aman dipakai di browser; AUTH_GOOGLE_SECRET hanya server-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
