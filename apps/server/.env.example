# Copy ke .env lalu sesuaikan bila perlu.
# Database (lihat docker-compose.yml)
DATABASE_URL=postgresql://dolenae:dolenae@localhost:5432/dolenae

# Server
PORT=3001
NODE_ENV=development

# Auth (JWT)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=7d

# CORS (dipisah koma). Kosongkan untuk mengizinkan semua (dev).
CORS_ORIGIN=

# Object storage (S3-compatible; MinIO self-host via docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dolenae
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Base URL publik untuk membentuk url file (bucket harus bisa dibaca publik).
S3_PUBLIC_URL=http://localhost:9000/dolenae
# MinIO butuh path-style (true). AWS S3 asli: false.
S3_FORCE_PATH_STYLE=true

# Batas ukuran upload (MB)
MAX_UPLOAD_MB=5
