# Dolenae API — example environment. Copy to `.env` and adjust.

NODE_ENV=development
PORT=3001

# PostgreSQL (dev: docker compose up -d)
# Port 5433 dipakai jika port 5432 sudah dipakai project lain.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dolenae:dolenae@localhost:5432/dolenae

# Comma-separated CORS origins. Empty = allow all (dev).
CORS_ORIGIN=http://localhost:3000

# Auth (placeholder, used in a later phase)
JWT_SECRET=dev-secret-change-me-please-1234567890
JWT_EXPIRES_IN=7d

# URL web app publik — dipakai untuk tautan di email (reset password & verifikasi).
# Produksi : https://dolenae.web.id
# Tes lokal: http://localhost:3000
# Dari HP  : http://<IP-LAN-komputer>:3000  (mis. http://192.168.1.10:3000)
APP_WEB_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=60

# Logging
LOG_LEVEL=info

# API docs (Scalar) at /api/docs
DOCS_ENABLED=true

# Google sign-in (POST /api/auth/google). `AUTH_GOOGLE_ID` juga diterima
# sebagai alias (gaya NextAuth).
GOOGLE_CLIENT_ID=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (Resend) — kirim email reset password.
RESEND_API_KEY=
MAIL_FROM=Dolenae <no-reply@dolenae.web.id>
# Opsional: alamat balasan yang benar-benar ada (mis. halo@dolenae.web.id).
MAIL_REPLY_TO=

# Image storage (S3-compatible). Dev: docker compose up -d (MinIO).
# `s3` uses MinIO/S3; `local` writes to UPLOAD_DIR and serves /uploads from the
# API (handy when Docker images are unavailable).
STORAGE_DRIVER=s3
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:3001
# S3_PUBLIC_URL is the public base used in stored image URLs.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dolenae
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/dolenae
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=5
