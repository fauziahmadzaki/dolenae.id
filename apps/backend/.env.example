# Dolenae API — example environment. Copy to `.env` and adjust.

NODE_ENV=development
PORT=3001

# PostgreSQL (dev: docker compose up -d)
DATABASE_URL=postgresql://dolenae:dolenae@localhost:5432/dolenae

# Comma-separated CORS origins. Empty = allow all (dev).
CORS_ORIGIN=http://localhost:3000

# Auth (placeholder, used in a later phase)
JWT_SECRET=dev-secret-change-me-please-1234567890
JWT_EXPIRES_IN=7d

# Public URL of the web app (password-reset & email-verification links) + reset
# token lifetime. Use the deployed origin, e.g. https://dolenae.web.id
APP_WEB_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=60

# Email via Resend. Leave empty in dev to log emails to the console.
# MAIL_FROM must use a domain verified in Resend (SPF/DKIM), otherwise
# sending fails. MAIL_REPLY_TO is optional (real inbox for replies).
RESEND_API_KEY=
MAIL_FROM=Dolenae <no-reply@dolenae.web.id>
MAIL_REPLY_TO=

# Google sign-in (OAuth client id). Leave empty to disable the endpoint.
# `AUTH_GOOGLE_ID` is accepted as an alias (NextAuth style).
GOOGLE_CLIENT_ID=

# Image storage (S3-compatible). Dev: docker compose up -d (MinIO).
# `s3` uses MinIO/S3; `local` writes to UPLOAD_DIR and serves /uploads from the
# API (handy when Docker images are unavailable).
STORAGE_DRIVER=s3
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:3001
# S3_PUBLIC_URL is the public base used in stored image URLs.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dolenae
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/dolenae
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=5

# Logging
LOG_LEVEL=info

# API docs (Scalar) at /api/docs. Set false in production.
DOCS_ENABLED=true
